  // =========================================================
  // REFLECT SCREEN
  // =========================================================
  function renderBars(){
    const row = document.getElementById('barsRow');
    row.innerHTML = '';
    const totals = getWeekDayTotals();
    const max = Math.max(1, ...totals);
    const todayIdx = mondayIndex(new Date());

    totals.forEach((val, i) => {
      const pct = val > 0 ? Math.max(14, (val / max) * 100) : 4;
      const col = document.createElement('div');
      col.className = 'bar-col';
      col.innerHTML = `
        <div class="bar-num num ${weekDetailsShown ? 'show' : ''}">${formatMoney(val)}</div>
        <div class="bar ${i === todayIdx ? 'today' : ''}" style="height:${pct}%"></div>
        <div class="bar-day">${shortWeekDays[i]}</div>
      `;
      row.appendChild(col);
    });

    renderWeekCopy(totals, todayIdx);
  }

  function renderWeekCopy(totals, todayIdx){
    const weekTotal = totals.reduce((a,b) => a+b, 0);
    const daysLogged = totals.filter(t => t > 0).length;
    const weekLineEl = document.getElementById('weekLine');
    const insightEl = document.getElementById('insightText');

    if(weekTotal === 0){
      weekLineEl.innerHTML = "Nothing's logged yet this week — it'll take shape as you go.";
      insightEl.textContent = "Log a few things on the Log tab and this page will start to fill in.";
      return;
    }

    let descriptor;
    const weeklyBudget = getFlexibleBudget('weekly');
    const weeklyBudgetTotal = weeklyBudget.flexible;
    if(weeklyBudget.total > 0 && weeklyBudgetTotal <= 0){
      descriptor = 'a <strong>tight</strong> week so far';
    } else if(weeklyBudgetTotal > 0){
      const ratio = weekTotal / weeklyBudgetTotal;
      if(ratio < 0.5) descriptor = 'a <strong>light</strong> week so far';
      else if(ratio < 0.85) descriptor = 'a <strong>steady</strong> week so far';
      else if(ratio <= 1) descriptor = 'getting <strong>close</strong> to your budget';
      else descriptor = 'a bit <strong>past</strong> your budget for the week';
    } else {
      descriptor = 'starting to take shape';
    }
    weekLineEl.innerHTML = `You've had ${descriptor}, with ${daysLogged} day${daysLogged===1?'':'s'} logged.`;

    if(daysLogged === 1){
      const loggedIdx = totals.findIndex(t => t > 0);
      insightEl.textContent = `${fullWeekDays[loggedIdx]} is the only day you've logged so far — nice start.`;
      return;
    }
    let maxIdx = 0;
    for(let i=1;i<totals.length;i++){ if(totals[i] > totals[maxIdx]) maxIdx = i; }
    insightEl.textContent = (maxIdx === todayIdx)
      ? "Today's been your biggest day so far this week — that's alright, tomorrow's a fresh start."
      : `${fullWeekDays[maxIdx]} has been your biggest day so far this week.`;
  }

