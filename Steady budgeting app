  // =========================================================
  // SOUND & TOUCH — everything is synthesized with Web Audio (no audio
  // files), and nothing starts until the person taps something.
  // =========================================================
  const TONES = { log:261.63, park:196.00, release:329.63, keep:293.66, budget:246.94, soft:392.00, breathe:174.61 };

  function getAudioCtx(){
    if(!model.settings.sound) return null;
    try{
      const AC = window.AudioContext || window.webkitAudioContext;
      if(!AC) return null;
      if(!audioCtx) audioCtx = new AC();
      if(audioCtx.state === 'suspended' && typeof audioCtx.resume === 'function') audioCtx.resume();
      return audioCtx;
    }catch(err){
      return null;
    }
  }

  // A soft singing-bowl strike: a few inharmonic partials (bowls ring at
  // roughly 1 : 2.7 : 5.2 times their base pitch), each a slightly detuned
  // pair so the tone gently beats, with a quick attack and a long decay.
  function playBowl(freq){
    const ctx = getAudioCtx();
    if(!ctx) return;
    try{
      const now = ctx.currentTime;
      const master = ctx.createGain();
      master.gain.value = 0.16;
      master.connect(ctx.destination);
      [[1, 1, 3.6], [2.7, 0.45, 2.4], [5.2, 0.2, 1.4]].forEach(([ratio, level, dur]) => {
        [0, 1.3].forEach(beat => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq * ratio + beat;
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.linearRampToValueAtTime(level * 0.5, now + 0.025);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);
          osc.connect(gain);
          gain.connect(master);
          osc.start(now);
          osc.stop(now + dur + 0.05);
        });
      });
      setTimeout(() => { try{ master.disconnect(); }catch(e){} }, 4200);
    }catch(err){
      // Sound is a nicety — it must never break the app.
    }
  }

  // Looping ocean: brown noise (deep, wave-like rumble) whose volume and
  // brightness swell together on a 10-second cycle that peaks at the end of
  // the in-breath, matching the breathing guide.
  function startOcean(){
    const ctx = getAudioCtx();
    if(!ctx) return null;
    try{
      const rate = ctx.sampleRate;
      const len = Math.floor(rate * 6);
      const fade = Math.floor(rate * 0.4);
      const buffer = ctx.createBuffer(1, len, rate);
      const data = buffer.getChannelData(0);
      let last = 0;
      for(let i = 0; i < len; i++){
        const white = Math.random() * 2 - 1;
        last = (last + 0.02 * white) / 1.02;
        data[i] = last * 3.5;
      }
      // Blend the start toward the tail so the loop point doesn't click.
      for(let i = 0; i < fade; i++){
        const t = i / fade;
        data[i] = data[i] * t + data[len - fade + i] * (1 - t);
      }

      const now = ctx.currentTime;
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      src.loop = true;
      src.loopStart = 0;
      src.loopEnd = (len - fade) / rate;

      const lowpass = ctx.createBiquadFilter();
      lowpass.type = 'lowpass';
      lowpass.frequency.value = 500;
      lowpass.Q.value = 0.7;

      const swell = ctx.createGain();
      swell.gain.value = 0.07;

      const lfo = ctx.createOscillator();
      try{
        // -cos: quietest at the start of the cycle, loudest 5 seconds in.
        lfo.setPeriodicWave(ctx.createPeriodicWave(new Float32Array([0, -1]), new Float32Array([0, 0])));
      }catch(e){ /* falls back to a plain sine */ }
      lfo.frequency.value = 0.1;
      const volDepth = ctx.createGain();
      volDepth.gain.value = 0.05;
      const toneDepth = ctx.createGain();
      toneDepth.gain.value = 250;
      lfo.connect(volDepth);
      volDepth.connect(swell.gain);
      lfo.connect(toneDepth);
      toneDepth.connect(lowpass.frequency);

      const master = ctx.createGain();
      master.gain.setValueAtTime(0, now);
      master.gain.linearRampToValueAtTime(1, now + 1.5);

      src.connect(lowpass);
      lowpass.connect(swell);
      swell.connect(master);
      master.connect(ctx.destination);
      src.start(now);
      lfo.start(now);

      return {
        stop(){
          try{
            const t = ctx.currentTime;
            master.gain.cancelScheduledValues(t);
            master.gain.setValueAtTime(master.gain.value, t);
            master.gain.linearRampToValueAtTime(0, t + 1);
            src.stop(t + 1.1);
            lfo.stop(t + 1.1);
            setTimeout(() => { try{ master.disconnect(); }catch(e){} }, 1300);
          }catch(err){}
        }
      };
    }catch(err){
      return null;
    }
  }

  function stopOcean(){
    if(oceanHandle){ oceanHandle.stop(); oceanHandle = null; }
  }

  // Vibration works on most Android browsers; iOS Safari ignores it.
  function haptic(pattern){
    if(!model.settings.sound) return;
    try{
      if(typeof navigator !== 'undefined' && navigator.vibrate) navigator.vibrate(pattern);
    }catch(err){}
  }

  function feedback(kind){
    if(!model.settings.sound) return;
    playBowl(TONES[kind] || TONES.log);
    haptic(kind === 'release' ? [8, 40, 8] : 10);
  }

