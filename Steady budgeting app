<script>
(function(){

  // =========================================================
  // MODEL
  // budgetHistory: [{ id, type:'topup'|'reset', amount, date(ISO), period }]
  //   — every top-up or new-total action, tagged with the period mode active
  //     at the time. The current cumulative total for a period is derived by
  //     replaying the history entries that fall within that period's current
  //     calendar window (this week / this month).
  // entries: [{ id, cat, amount, date(ISO string) }] — spending log
  // =========================================================
  // fixedCosts: [{ id, name, amount, freq:'weekly'|'monthly' }] — recurring
  //   commitments. Steady reserves their share of the current period before
  //   the orb is judged, so the orb only reflects money that is safe to spend.
  // jar: [{ id, name, amount|null, parkedAt(ISO), status:'parked'|'kept'|'released',
  //   resolvedAt(ISO)|null }] — the 48-hour cooling-off jar.
  // settings: { sound } — one switch for chimes and haptics.
  const model = {
    currency: 'USD',
    period: 'weekly',
    budgetHistory: [],
    entries: [],
    fixedCosts: [],
    jar: [],
    settings: { sound: true }
  };

  const STORAGE_KEY = 'steady:state';
  const JAR_MS = 48 * 60 * 60 * 1000;          // the cooling-off window
  const WEEKS_PER_MONTH = 52 / 12;             // used to convert fixed costs between periods
  const MAX_ITEMS = 5000;                      // guard against absurd restore files

  const categoryDefaults = { food:15, home:50, fun:20, transport:12, care:30, other:20 };

  const currencies = [
    { code:'USD', sym:'$' },
    { code:'EUR', sym:'€' },
    { code:'GBP', sym:'£' },
    { code:'INR', sym:'₹' },
    { code:'JPY', sym:'¥' },
    { code:'AUD', sym:'A$' },
    { code:'CAD', sym:'C$' },
  ];

  const categories = [
    { key:'food', label:'Food', icon:'<path d="M7 3v7a2 2 0 0 0 2 2h0M9 3v9M13 3c0 3-2 3-2 6v9"/>' },
    { key:'home', label:'Home', icon:'<path d="M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>' },
    { key:'fun', label:'Fun', icon:'<circle cx="12" cy="12" r="8"/><path d="M9 10h.01M15 10h.01M8.5 15c1 1 6 1 7 0"/>' },
    { key:'transport', label:'Transport', icon:'<rect x="3.5" y="9" width="17" height="7" rx="2"/><circle cx="7.5" cy="17.5" r="1.3"/><circle cx="16.5" cy="17.5" r="1.3"/>' },
    { key:'care', label:'Care', icon:'<path d="M12 20s-7-4.4-7-9.6A4.4 4.4 0 0 1 12 7.8a4.4 4.4 0 0 1 7 2.6C19 15.6 12 20 12 20z"/>' },
    { key:'other', label:'Other', icon:'<circle cx="6" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="18" cy="12" r="1.4"/>' },
  ];

  const fullWeekDays = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
  const shortWeekDays = ['M','T','W','T','F','S','S'];

  const STATE_COLOR_VARS = {
    clear:  ['--clear','--clear-soft','--clear-tint','--clear-shadow','--clear-bg'],
    hazy:   ['--hazy','--hazy-soft','--hazy-tint','--hazy-shadow','--hazy-bg'],
    stormy: ['--stormy','--stormy-soft','--stormy-tint','--stormy-shadow','--stormy-bg']
  };

  const STATE_COPY = {
    clear:  { headline: "You're doing okay", sub: "There's a bit of room to breathe right now.", motes: 3 },
    hazy:   { headline: "Things are a little tight", sub: "Nothing urgent — just worth going gently on extras.", motes: 5 },
    stormy: { headline: "Take a breath", sub: "It's a snug stretch. One small step at a time is plenty.", motes: 7 }
  };

  // =========================================================
  // HELPERS: currency / money formatting
  // =========================================================
  function currencySymbol(){
    return (currencies.find(c => c.code === model.currency) || currencies[0]).sym;
  }
  function formatMoney(amount){
    const rounded = Math.round(amount);
    return `${currencySymbol()}${Math.abs(rounded).toLocaleString()}`;
  }

  // =========================================================
  // HELPERS: dates / periods
  // =========================================================
  function mondayIndex(date){ return (date.getDay() + 6) % 7; } // Mon=0 ... Sun=6

  function startOfWeek(date){
    const d = new Date(date);
    d.setHours(0,0,0,0);
    d.setDate(d.getDate() - mondayIndex(d));
    return d;
  }
  function startOfMonth(date){
    const d = new Date(date.getFullYear(), date.getMonth(), 1);
    d.setHours(0,0,0,0);
    return d;
  }
  function getPeriodWindow(period){
    const now = new Date();
    if(period === 'monthly'){
      const start = startOfMonth(now);
      const end = new Date(start.getFullYear(), start.getMonth() + 1, 1);
      return { start, end };
    }
    const start = startOfWeek(now);
    const end = new Date(start);
    end.setDate(end.getDate() + 7);
    return { start, end };
  }
  function getSpent(period){
    const { start, end } = getPeriodWindow(period);
    return model.entries.reduce((sum, e) => {
      const d = new Date(e.date);
      return (d >= start && d < end) ? sum + e.amount : sum;
    }, 0);
  }
  function getWeekDayTotals(){
    const { start } = getPeriodWindow('weekly');
    const totals = [0,0,0,0,0,0,0];
    model.entries.forEach(e => {
      const d = new Date(e.date);
      const dayDiff = Math.floor((d - start) / 86400000);
      if(dayDiff >= 0 && dayDiff < 7) totals[dayDiff] += e.amount;
    });
    return totals;
  }

  // Cumulative budget total for the CURRENT cycle of a given period type.
  // Replays that period's history entries (topup/reset) within the current
  // calendar window, in chronological order, starting from 0. This means
  // a new week/month naturally starts at $0 until a budget is set for it —
  // weekly and monthly are tracked as separate, independent budgets.
  function getBudgetTotal(period){
    const { start, end } = getPeriodWindow(period);
    const relevant = model.budgetHistory
      .filter(h => h.period === period)
      .filter(h => { const d = new Date(h.date); return d >= start && d < end; })
      .sort((a,b) => new Date(a.date) - new Date(b.date));
    let total = 0;
    relevant.forEach(h => { total = (h.type === 'reset') ? h.amount : total + h.amount; });
    return { total, count: relevant.length, entries: relevant };
  }

  function relativeDayLabel(dateStr){
    const d = new Date(dateStr);
    const today = new Date(); today.setHours(0,0,0,0);
    const dOnly = new Date(d); dOnly.setHours(0,0,0,0);
    const diffDays = Math.round((today - dOnly) / 86400000);
    if(diffDays <= 0) return 'today';
    if(diffDays === 1) return 'yesterday';
    return `${diffDays} days ago`;
  }

  // =========================================================
  // SMALL SHARED HELPERS
  // =========================================================
  function newId(){ return Date.now() + '-' + Math.random().toString(36).slice(2, 7); }
  function isPosNum(v){ return typeof v === 'number' && isFinite(v) && v > 0; }
  function isIsoDate(v){ return typeof v === 'string' && !isNaN(new Date(v).getTime()); }
  function cleanText(v, max){
    return String(v == null ? '' : v).replace(/[\u0000-\u001f\u007f]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, max);
  }
  // Accepts "1,200", "$45.50" and similar; NaN when nothing usable is there.
  function parseAmount(raw){
    const cleaned = String(raw == null ? '' : raw).replace(/[^0-9.\-]/g, '');
    return cleaned ? parseFloat(cleaned) : NaN;
  }
  function plural(n, one, many){ return n === 1 ? one : many; }

  // Tiny element builder. Text goes in via textContent, so anything a person
  // types (item names, fixed-cost names) can never be read as HTML.
  function h(tag, props){
    const el = document.createElement(tag);
    const p = props || {};
    Object.keys(p).forEach(key => {
      const val = p[key];
      if(key === 'class') el.className = val;
      else if(key === 'text') el.textContent = val;
      else if(key === 'on') Object.keys(val).forEach(ev => el.addEventListener(ev, val[ev]));
      else el.setAttribute(key, val);
    });
    for(let i = 2; i < arguments.length; i++){
      if(arguments[i]) el.appendChild(arguments[i]);
    }
    return el;
  }

  // =========================================================
  // PERSISTENCE (best-effort — app works fine without it)
  // =========================================================
  // `window.storage` can exist as an object without actually working
  // (methods missing, calls rejecting, sandbox restrictions, etc.), so
  // rather than trusting mere presence, we run one real write+read
  // round-trip and cache whether it actually succeeded. Every call site
  // below checks that cached result instead of `if(!window.storage)`.
  let storageAvailable = null; // null = untested yet

  async function checkStorageAvailable(){
    if(storageAvailable !== null) return storageAvailable;
    try{
      if(!window.storage || typeof window.storage.set !== 'function' || typeof window.storage.get !== 'function'){
        storageAvailable = false;
        return false;
      }
      const probeKey = 'steady:__storage_probe__';
      const probeValue = String(Date.now());
      await window.storage.set(probeKey, probeValue, false);
      const res = await window.storage.get(probeKey, false);
      storageAvailable = !!(res && res.value === probeValue);
    }catch(err){
      storageAvailable = false;
    }
    return storageAvailable;
  }

  // Everything below funnels through serializeState / sanitizeState /
  // applyState, so saving, loading, backup and restore can never drift apart.
  function serializeState(){
    return {
      currency: model.currency,
      period: model.period,
      budgetHistory: model.budgetHistory,
      entries: model.entries,
      fixedCosts: model.fixedCosts,
      jar: model.jar,
      settings: model.settings
    };
  }

  // Never trust stored or imported data: check every field, drop what's
  // malformed, and fill in defaults for anything an older version didn't have.
  function sanitizeState(raw){
    const s = (raw && typeof raw === 'object') ? raw : {};
    const arr = v => Array.isArray(v) ? v.slice(-MAX_ITEMS) : [];
    const catKeys = categories.map(c => c.key);
    const out = {
      currency: currencies.some(c => c.code === s.currency) ? s.currency : 'USD',
      period: s.period === 'monthly' ? 'monthly' : 'weekly',
      budgetHistory: [], entries: [], fixedCosts: [], jar: [],
      settings: { sound: !(s.settings && s.settings.sound === false) }
    };
    arr(s.budgetHistory).forEach(x => {
      if(x && (x.type === 'topup' || x.type === 'reset') && isPosNum(x.amount) && isIsoDate(x.date)){
        out.budgetHistory.push({
          id: (typeof x.id === 'string' && x.id) ? x.id.slice(0, 60) : newId(),
          type: x.type, amount: x.amount, date: new Date(x.date).toISOString(),
          period: x.period === 'monthly' ? 'monthly' : 'weekly'
        });
      }
    });
    if(!Array.isArray(s.budgetHistory) && isPosNum(s.budget)){
      // Oldest format: a single budget number.
      out.budgetHistory.push({ id: 'migrated', type: 'reset', amount: s.budget, date: new Date().toISOString(), period: out.period });
    }
    arr(s.entries).forEach(x => {
      if(x && isPosNum(x.amount) && isIsoDate(x.date)){
        out.entries.push({
          id: (typeof x.id === 'string' && x.id) ? x.id.slice(0, 60) : newId(),
          cat: catKeys.indexOf(x.cat) >= 0 ? x.cat : 'other',
          amount: x.amount, date: new Date(x.date).toISOString()
        });
      }
    });
    arr(s.fixedCosts).forEach(x => {
      const name = cleanText(x && x.name, 40);
      if(x && name && isPosNum(x.amount)){
        out.fixedCosts.push({
          id: (typeof x.id === 'string' && x.id) ? x.id.slice(0, 60) : newId(),
          name, amount: x.amount, freq: x.freq === 'weekly' ? 'weekly' : 'monthly'
        });
      }
    });
    arr(s.jar).forEach(x => {
      const name = cleanText(x && x.name, 60);
      if(x && name && isIsoDate(x.parkedAt)){
        const status = (x.status === 'kept' || x.status === 'released') ? x.status : 'parked';
        out.jar.push({
          id: (typeof x.id === 'string' && x.id) ? x.id.slice(0, 60) : newId(),
          name, amount: isPosNum(x.amount) ? x.amount : null,
          parkedAt: new Date(x.parkedAt).toISOString(), status,
          resolvedAt: (status !== 'parked' && isIsoDate(x.resolvedAt)) ? new Date(x.resolvedAt).toISOString() : null
        });
      }
    });
    return out;
  }

  function applyState(clean){
    model.currency = clean.currency;
    model.period = clean.period;
    model.budgetHistory = clean.budgetHistory;
    model.entries = clean.entries;
    model.fixedCosts = clean.fixedCosts;
    model.jar = clean.jar;
    model.settings = clean.settings;
  }

  async function loadState(){
    try{
      if(!(await checkStorageAvailable())) return;
      const res = await window.storage.get(STORAGE_KEY, false);
      if(res && res.value) applyState(sanitizeState(JSON.parse(res.value)));
    }catch(err){
      // No saved state yet, or storage unavailable — continue with defaults.
    }
  }

  // Saves run one at a time. If something changes while a save is in flight,
  // exactly one more save follows with the latest state, so a slow earlier
  // write can never land last and overwrite newer data.
  let persisting = false;
  let persistAgain = false;
  async function persist(){
    if(persisting){ persistAgain = true; return; }
    persisting = true;
    try{
      do{
        persistAgain = false;
        if(!(await checkStorageAvailable())) break;
        await window.storage.set(STORAGE_KEY, JSON.stringify(serializeState()), false);
      }while(persistAgain);
    }catch(err){
      // Best-effort — session still works, it just won't persist.
    }finally{
      persisting = false;
    }
  }

  // =========================================================
  // UI STATE
  // =========================================================
  let selectedCat = null;
  let numbersShown = false;
  let weekDetailsShown = false;
  let budgetMode = 'add'; // 'add' (top-up) | 'reset' (new total)
  let budgetDraftAmount = 50;
  let budgetExactOpen = false;
  let tutorialIndex = 0;
  let saveEntryReturnTimer = null;
  let toastTimer = null;
  let audioCtx = null;
  let oceanHandle = null;
  let jarNumbersShown = false;
  let jarTimer = null;
  let fixedFreq = 'monthly';
  let pendingRestore = null;
  let renderedMotes = -1;
  const TUTORIAL_SLIDE_COUNT = 7;
  const TUTORIAL_SEEN_KEY = 'steady:tutorialSeen';

  // =========================================================
  // DERIVED MONEY STATE (never surfaced as raw numbers on Today)
  // =========================================================
  // A fixed cost's share of a given period (monthly rent in a weekly view
  // reserves a week's worth of it, and so on).
  function toPeriodAmount(cost, period){
    if(cost.freq === period) return cost.amount;
    return period === 'weekly' ? cost.amount / WEEKS_PER_MONTH : cost.amount * WEEKS_PER_MONTH;
  }
  function getFixedReserved(period){
    return model.fixedCosts.reduce((sum, c) => sum + toPeriodAmount(c, period), 0);
  }
  // total = everything in the budget; reserved = set aside for fixed costs;
  // flexible = what is genuinely safe to spend (can go negative).
  function getFlexibleBudget(period){
    const { total } = getBudgetTotal(period);
    const reserved = getFixedReserved(period);
    return { total, reserved, flexible: total - reserved };
  }

  function getMoneyState(){
    const { flexible } = getFlexibleBudget(model.period);
    if(flexible <= 0) return 'stormy';
    const ratio = getSpent(model.period) / flexible;
    if (ratio < 0.6) return 'clear';
    if (ratio < 0.85) return 'hazy';
    return 'stormy';
  }

  function applyStateColors(state){
    const root = document.documentElement.style;
    const [colorVar, softVar, tintVar, shadowVar, bgVar] = STATE_COLOR_VARS[state];
    root.setProperty('--state-color', `var(${colorVar})`);
    root.setProperty('--state-soft', `var(${softVar})`);
    root.setProperty('--state-tint', `var(${tintVar})`);
    root.setProperty('--state-shadow', `var(${shadowVar})`);
    root.setProperty('--bg-top', `var(${bgVar})`);
  }

  // Droplets orbit inside the goo layer. They're deliberately larger than plain
  // dots: the filter erases anything too small, so these are sized to survive it
  // and to melt into the orb when they drift close. Only rebuilt when the count
  // changes, so re-rendering Today doesn't make them jump.
  function renderMotes(count){
    if(count === renderedMotes) return;
    renderedMotes = count;
    const stage = document.getElementById('orbGoo');
    stage.querySelectorAll('.mote').forEach(m => m.remove());
    const radius = 102;
    for(let i=0;i<count;i++){
      const angle = (i / count) * Math.PI * 2;
      const dist = radius + (i % 2 === 0 ? 0 : 14);
      const size = 18 + (i % 3) * 4;
      const x = 115 + Math.cos(angle) * dist - size / 2;
      const y = 115 + Math.sin(angle) * dist - size / 2;
      const mote = document.createElement('div');
      mote.className = 'mote';
      mote.style.width = size + 'px';
      mote.style.height = size + 'px';
      mote.style.left = x + 'px';
      mote.style.top = y + 'px';
      mote.style.animationDelay = (i * 0.6) + 's';
      mote.style.animationDuration = (7 + i % 4) + 's';
      stage.insertBefore(mote, stage.firstChild);
    }
  }

  // =========================================================
  // TODAY SCREEN
  // =========================================================
  function renderToday(){
    const b = getFlexibleBudget(model.period);
    const periodLabel = model.period === 'weekly' ? 'this week' : 'this month';
    const headlineEl = document.getElementById('stateHeadline');
    const subEl = document.getElementById('stateSub');
    const valueEl = document.getElementById('numberValue');
    const noteEl = document.getElementById('numberSub');

    if(b.total <= 0){
      // Nothing set for this cycle yet — gentle prompt rather than a stark $0.
      applyStateColors('clear');
      headlineEl.textContent = "Let's set a budget";
      subEl.textContent = "Head to the Budget tab whenever you're ready.";
      renderMotes(STATE_COPY.clear.motes);
      valueEl.textContent = `Nothing set yet ${periodLabel}`;
      noteEl.textContent = '';
    } else if(b.flexible <= 0){
      // Fixed costs take the whole budget: say so plainly, without alarm.
      applyStateColors('stormy');
      headlineEl.textContent = STATE_COPY.stormy.headline;
      subEl.textContent = `Your fixed costs take up the whole budget ${periodLabel}. Adding funds will open up some room.`;
      renderMotes(STATE_COPY.stormy.motes);
      valueEl.textContent = 'Nothing free after fixed costs';
      noteEl.textContent = `${formatMoney(b.reserved)} is set aside ${periodLabel}`;
    } else {
      const state = getMoneyState();
      applyStateColors(state);
      headlineEl.textContent = STATE_COPY[state].headline;
      subEl.textContent = STATE_COPY[state].sub;
      renderMotes(STATE_COPY[state].motes);

      const remaining = b.flexible - getSpent(model.period);
      const word = b.reserved > 0 ? 'safe to spend' : 'left';
      valueEl.textContent = remaining >= 0
        ? `${formatMoney(remaining)} ${word} ${periodLabel}`
        : `${formatMoney(remaining)} over ${periodLabel}`;
      noteEl.textContent = b.reserved > 0 ? `after ${formatMoney(b.reserved)} set aside for fixed costs` : '';
    }

    const hour = new Date().getHours();
    const greet = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
    document.getElementById('greetingText').textContent = greet;
    document.getElementById('dateText').textContent =
      new Date().toLocaleDateString(undefined, { weekday:'long', month:'long', day:'numeric' });

    syncNumberVisibility();
    updateJarIndicators();
  }

