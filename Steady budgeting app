  function saveEntry(){
    if(!selectedCat) return;
    const exactVal = parseAmount(document.getElementById('exactInput').value);
    const amount = (!isNaN(exactVal) && exactVal > 0) ? exactVal : (categoryDefaults[selectedCat] || 15);

    model.entries.push({
      id: Date.now() + '-' + Math.random().toString(36).slice(2,7),
      cat: selectedCat,
      amount,
      date: new Date().toISOString()
    });
    persist();

    showToast("Logged. That's one less thing to hold onto.");
    feedback('log');
    resetLogForm();
    renderToday();

    // Gently return to Today so the confirmation lands somewhere calm.
    // Guarded so it never yanks the person away if they've already
    // navigated elsewhere themselves in that brief window, and so
    // logging several entries quickly doesn't stack up return-jumps.
    if(saveEntryReturnTimer) clearTimeout(saveEntryReturnTimer);
    saveEntryReturnTimer = setTimeout(() => {
